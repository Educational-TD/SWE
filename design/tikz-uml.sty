%
% main command to define a relationship between two classes through a control node
% args : src class
%        control node
%        dest class
% optional : arg1, arg2, arg: name of the src/dest/dest side class type attribute defined by the relationship
%            mult1, mult2, mult: multiplicity of the src/dest/dest side class type attribute defined by the relationship
%            pos1, pos2, pos: position of the src/dest/dest side class type attribute defined by the relationship
%            align1, align2, align: text justification of the src/dest/dest side class type attribute defined by the relationship
%            anchor1, anchor2: src/dest anchors on linked classes
%            stereo: stereotype of the relationship
%            pos stereo: position of the stereotype on the relationship
%            style: style of the relationship (association, aggregation, composition, inherit, ...)
%            name: rootname used for naming nodes of the relationship
\newcommand{\umlCNrelationship}[4][]{%
  \pgfkeys{/tikzuml/relationship/.cd,%
            name/.initial=relationship-\thetikzumlRelationshipNum,%
            type/.initial=association,%
            arg1/.initial={},%
            arg2/.initial={},%
            arg/.initial={},%
            mult1/.initial={},%
            mult2/.initial={},%
            mult/.initial={},%
            pos1/.initial=0.2,%
            pos2/.initial=0.8,%
            pos/.initial=tikzumlEmpty,%
            align1/.initial={},%
            align2/.initial={},%
            align/.initial={},%
            anchor1/.initial=tikzumlEmpty,%
            anchor2/.initial=tikzumlEmpty,%
            stereo/.initial={},%
            pos stereo/.initial=1,%
            .unknown/.code={%
              \let\keyname=\pgfkeyscurrentname%
              \let\keyvalue=\pgfkeyscurrentvalue%
              \errmessage{TIKZUML ERROR : in umlCNrelationship, invalid option \keyname}%
            }%
  }%
  \pgfkeys{/tikzuml/relationship/.cd,#1}%
  \pgfkeys{/tikzuml/relationship/.cd,%
            name/.get=\tikzumlCNRelationshipName,%
            type/.get=\tikzumlCNRelationshipType,%
            arg1/.get=\tikzumlCNRelationshipAttrName,%
            arg2/.get=\tikzumlCNRelationshipAttrNameTO,%
            arg/.get=\tikzumlCNRelationshipAttrNameTT,%
            mult1/.get=\tikzumlCNRelationshipMultiplicity,%
            mult2/.get=\tikzumlCNRelationshipMultiplicityTO,%
            mult/.get=\tikzumlCNRelationshipMultiplicityTT,%
            pos1/.get=\tikzumlCNRelationshipPosition,%
            pos2/.get=\tikzumlCNRelationshipPositionTO,%
            pos/.get=\tikzumlCNRelationshipPositionTT,%
            align1/.get=\tikzumlCNRelationshipAlign,%
            align2/.get=\tikzumlCNRelationshipAlignTO,%
            align/.get=\tikzumlCNRelationshipAlignTT,%
            anchor1/.get=\tikzumlCNRelationshipSrcAnchor,%
            anchor2/.get=\tikzumlCNRelationshipDestAnchor,%
            stereo/.get=\tikzumlCNRelationshipStereoType,%
            pos stereo/.get=\tikzumlCNRelationshipPositionStereo%
  }%
  %
  % managing \_ in class names for node names
  \def\tikzumlSrcClassName{#2}%
  \begingroup%
    \def\_{_}\edef\x{\endgroup%
      \def\noexpand\tikzumlSrcClassNodeName{\tikzumlSrcClassName}}\x%
  %
  \StrSubstitute{\tikzumlSrcClassNodeName}{:}{@COLON@}[\tikzumlSrcClassNodeName]%
  \StrSubstitute{\tikzumlSrcClassNodeName}{\_}{@UNDERSCORE@}[\tikzumlSrcClassNodeName]%
  %
  \def\tikzumlDestClassName{#4}%
  \begingroup%
    \def\_{_}\edef\x{\endgroup%
      \def\noexpand\tikzumlDestClassNodeName{\tikzumlDestClassName}}\x%
  %
  \StrSubstitute{\tikzumlDestClassNodeName}{:}{@COLON@}[\tikzumlDestClassNodeName]%
  \StrSubstitute{\tikzumlDestClassNodeName}{\_}{@UNDERSCORE@}[\tikzumlDestClassNodeName]%
  %
  % managing alias keys
  \def\tikzumlCNRelationshipAttrNameT{\tikzumlCNRelationshipAttrNameTO\tikzumlCNRelationshipAttrNameTT}%
  \def\tikzumlCNRelationshipMultiplicityT{\tikzumlCNRelationshipMultiplicityTO\tikzumlCNRelationshipMultiplicityTT}%
  \def\tikzumlCNRelationshipAlignT{\tikzumlCNRelationshipAlignTO\tikzumlCNRelationshipAlignTT}%
  \def\orientationT{\orientationTO\orientationTT}%
  %
  \ifthenelse{\equal{\tikzumlCNRelationshipPositionTT}{tikzumlEmpty}}{%
    \def\tikzumlCNRelationshipPositionT{\tikzumlCNRelationshipPositionTO}%
  }{%
    \def\tikzumlCNRelationshipPositionT{\tikzumlCNRelationshipPositionTT}%
  }%
  %
  \def\attrAlign{}%
  \def\multAlign{}%
  \def\attrAlignT{}%
  \def\multAlignT{}%
  %
  \ifthenelse{\equal{\tikzumlCNRelationshipAlign}{left}}{%
    \def\attrAlign{above right}%
    \def\multAlign{below right}%
  }{%
    \ifthenelse{\equal{\tikzumlCNRelationshipAlign}{right}}{%
      \def\attrAlign{above left}%
      \def\multAlign{below left}%
    }{}%
  }%
  %
  \ifthenelse{\equal{\tikzumlCNRelationshipAlignT}{left}}{%
    \def\attrAlignT{above right}%
    \def\multAlignT{below right}%
  }{%
    \ifthenelse{\equal{\tikzumlCNRelationshipAlignT}{right}}{%
      \def\attrAlignT{above left}%
      \def\multAlignT{below left}%
    }{}%
  }%
  %
  % def stereotype
  \ifthenelse{\equal{\tikzumlCNRelationshipStereoType}{}}{%
    \def\stereotype{}%
  }{%
    \def\stereotype{$\ll$\tikzumlCNRelationshipStereoType$\gg$}%
  }%
  %
  % def anchors macros
  \ifthenelse{\equal{\tikzumlCNRelationshipSrcAnchor}{tikzumlEmpty}}{%
    \def\tikzumlCNRelationshipSrcAnchor{}%
  }{%
    \let\tikzumlCNRelationshipSrcAnchorold\tikzumlCNRelationshipSrcAnchor%
    \def\tikzumlCNRelationshipSrcAnchor{.\tikzumlCNRelationshipSrcAnchorold}%
  }%
  %
  \ifthenelse{\equal{\tikzumlCNRelationshipDestAnchor}{tikzumlEmpty}}{%
    \def\tikzumlCNRelationshipDestAnchor{}%
  }{%
    \let\tikzumlCNRelationshipDestAnchorold\tikzumlCNRelationshipDestAnchor%
    \def\tikzumlCNRelationshipDestAnchor{.\tikzumlCNRelationshipDestAnchorold}%
  }%
  %
  \setcounter{pos}{100*\real{\tikzumlCNRelationshipPosition}}%
  \setcounter{posT}{100*\real{\tikzumlCNRelationshipPositionT}}%
  \setcounter{posStereo}{100*\real{\tikzumlCNRelationshipPositionStereo}}%
  %
  % straight line
  %\setcounter{tikzumlControlNodesNum}{1}%
  %
  \def\tikzumlFirstArc{node[midway, name=\tikzumlCNRelationshipName-1, anchor=center] {} }%
  \def\tikzumlLastArc{node[midway, name=\tikzumlCNRelationshipName-3, anchor=center] {} }%
  \def\posAttrName{}%
  \def\posMultiplicity{}%
  \def\posAttrNameT{}%
  \def\posMultiplicityT{}%
  %
  \begin{pgfonlayer}{connections}%
  \node (\tikzumlCNRelationshipName-2) at (#3) {};%
  \end{pgfonlayer}%
  %
  \ifnum\theposStereo>100%
    \pgfmathsetmacro{\tikzumlCNRelationshipPositionStereo}{(\theposStereo-100)/100}%
    \xdef\tikzumlLastArc{\tikzumlLastArc node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlCNRelationshipName-stereotype, pos=\tikzumlCNRelationshipPositionStereo, anchor=center] {\stereotype} }%
  \else%
    \xdef\tikzumlFirstArc{\tikzumlFirstArc node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlCNRelationshipName-stereotype, pos=\tikzumlCNRelationshipPositionStereo, anchor=center] {\stereotype} }%
  \fi%
  %
  \ifnum\thepos>100%
    \pgfmathsetmacro{\tikzumlCNRelationshipPosition}{(\thepos-100)/100}%
    \def\arcNum{2}%
  \else%
    \def\arcNum{1}%
    \ifnum\thepos=100%
      \def\posAttrName{above left}%
      \def\posMultiplicity{below right}%
    \fi%
  \fi%
  %
  \ifnum\arcNum=1%
    \xdef\tikzumlFirstArc{\tikzumlFirstArc node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlCNRelationshipName-attr, pos=\tikzumlCNRelationshipPosition, \posAttrName, \attrAlign] {\tikzumlCNRelationshipAttrName}%
                                           node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlCNRelationshipName-mult, pos=\tikzumlCNRelationshipPosition, swap, \posMultiplicity, \multAlign] {\tikzumlCNRelationshipMultiplicity} }%
  \fi%
  \ifnum\arcNum=2%
    \xdef\tikzumlLastArc{\tikzumlLastArc node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlCNRelationshipName-attr, pos=\tikzumlCNRelationshipPosition, \posAttrName, \attrAlign] {\tikzumlCNRelationshipAttrName}%
                                         node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlCNRelationshipName-mult, pos=\tikzumlCNRelationshipPosition, swap, \posMultiplicity, \multAlign] {\tikzumlCNRelationshipMultiplicity} }%
  \fi%
  %
  \ifnum\theposT>100%
    \pgfmathsetmacro{\tikzumlCNRelationshipPositionT}{(\theposT-100)/100}%
    \def\arcNumT{2}%
  \else%
    \def\arcNumT{1}%
    \ifnum\theposT=100%
      \def\posAttrNameT{above left}%
      \def\posMultiplicityT{below right}%
    \fi%
  \fi%
  %
  \ifnum\arcNumT=1%
    \xdef\tikzumlFirstArc{\tikzumlFirstArc node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlCNRelationshipName-attr2, pos=\tikzumlCNRelationshipPositionT, \posAttrNameT, \attrAlignT] {\tikzumlCNRelationshipAttrNameT}%
                                           node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlCNRelationshipName-mult2, pos=\tikzumlCNRelationshipPositionT, swap, \posMultiplicityT, \multAlignT] {\tikzumlCNRelationshipMultiplicityT} }%
  \fi%
  \ifnum\arcNumT=2%
    \xdef\tikzumlLastArc{\tikzumlLastArc node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlCNRelationshipName-attr2, pos=\tikzumlCNRelationshipPositionT, \posAttrNameT, \attrAlignT] {\tikzumlCNRelationshipAttrNameT}%
                                         node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlCNRelationshipName-mult2, pos=\tikzumlCNRelationshipPositionT, swap, \posMultiplicityT, \multAlignT] {\tikzumlCNRelationshipMultiplicityT} }%
  \fi%
  %
  \xdef\tikzumlPath{(\tikzumlSrcClassNodeName\tikzumlCNRelationshipSrcAnchor) -- \tikzumlFirstArc (\tikzumlCNRelationshipName-2.base) -- \tikzumlLastArc (\tikzumlDestClassNodeName\tikzumlCNRelationshipDestAnchor) }%
  
  \begin{pgfonlayer}{connections}%
  \draw[auto, draw=\tikzumlRelationshipDrawColor, font=\tikzumlDefaultFont, /tikzuml/style, tikzuml \tikzumlCNRelationshipType] \tikzumlPath ;%
  \end{pgfonlayer}%
  %
  \stepcounter{tikzumlRelationshipNum}%
}%
