% main command to define a relationship between two classes
% args : src class
%        dest class
% optional : geometry: geometry of the line
%            weight: barycentric weight of the middle part when geometry is a 3-line
%            arm1, arm2: lengths of first or last part when geometry id a 3-line
%            arg1, arg2, arg: name of the src/dest/dest side class type attribute defined by the relationship
%            mult1, mult2, mult: multiplicity of the src/dest/dest side class type attribute defined by the relationship
%            pos1, pos2, pos: position of the src/dest/dest side class type attribute defined by the relationship
%            align1, align2, align: text justification of the src/dest/dest side class type attribute defined by the relationship
%            anchor1, anchor2: src/dest anchors on linked classes
%            angle1, angle2, loopsize: start angle, end angle and size of the relationship (only if recursive)
%            stereo: stereotype of the relationship
%            pos stereo: position of the stereotype on the relationship
%            style: style of the relationship (association, aggregation, composition, inherit, ...)
%            name: rootname used for naming nodes of the relationship
%            recursive mode: type of recursive arrow (transition for state diagrams, or default)
%            recursive direction start/end: when transition relationship, start/end directions of the relationship arrow
\newcommand{\umlrelationship}[3][]{%
  \pgfkeys{/tikzuml/relationship/.cd,%
            draw/.initial=\tikzumlRelationshipDefaultDrawColor,%
            fill/.initial=\tikzumlRelationshipDefaultFillColor,%
            text/.initial=\tikzumlRelationshipDefaultTextColor,%
            geometry/.initial=\tikzumlRelationshipDefaultGeometry,%
            type/.initial=association,%
            weight/.initial=\tikzumlRelationshipDefaultWeight,%
            arm1/.initial=auto,%
            arm2/.initial=auto,%
            arg1/.initial={},%
            arg2/.initial={},%
            arg/.initial={},%
            mult1/.initial={},%
            mult2/.initial={},%
            mult/.initial={},%
            pos1/.initial=\tikzumlRelationshipDefaultPosO,%
            pos2/.initial=\tikzumlRelationshipDefaultPosT,%
            pos/.initial=tikzumlEmpty,%
            align1/.initial={},%
            align2/.initial={},%
            align/.initial={},%
            anchor1/.initial=tikzumlEmpty,%
            anchor2/.initial=tikzumlEmpty,%
            angle1/.initial=\tikzumlRelationshipDefaultAngleO,%
            angle2/.initial=\tikzumlRelationshipDefaultAngleT,%
            loopsize/.initial=\tikzumlRelationshipDefaultLoopSize,%
            stereo/.initial={},%
            pos stereo/.initial=\tikzumlRelationshipDefaultPosStereo,%
            style/.style={},%
            name/.initial=relationship-\thetikzumlRelationshipNum,%
            recursive mode/.initial=default,%
            recursive direction start/.initial=right,%
            recursive direction end/.initial=bottom,%
            .unknown/.code={%
              \let\keyname=\pgfkeyscurrentname%
              \let\keyvalue=\pgfkeyscurrentvalue%
              \ifthenelse{\equal{\keyname}{with port}%
                        \OR\equal{\keyname}{interface}%
                        \OR\equal{\keyname}{padding}%
                        \OR\equal{\keyname}{width}%
                        \OR\equal{\keyname}{first arm}%
                        \OR\equal{\keyname}{second arm}%
                        \OR\equal{\keyname}{middle arm}%
                        \OR\equal{\keyname}{last arm}%
                        \OR\equal{\keyname}{distance}}{}{%
                          \ifx\keyvalue\pgfkeysnovalue%
                            \pgfkeys{/tikzuml/relationship/.cd, style/.append style/.expand once={\keyname}}%
                          \else%
                            \pgfkeys{/tikzuml/relationship/.cd, style/.append style/.expand twice={\expandafter\keyname\expandafter=\keyvalue}}%
                          \fi%
              }%
            }%
  }%
  \pgfkeys{/tikzuml/relationship/.cd,#1}%
  \pgfkeys{/tikzuml/relationship/.cd,%
            draw/.get=\tikzumlRelationshipDrawColor,%
            fill/.get=\tikzumlRelationshipFillColor,%
            text/.get=\tikzumlRelationshipTextColor,%
            geometry/.get=\tikzumlRelationshipGeometry,%
            type/.get=\tikzumlRelationshipType,%
            weight/.get=\tikzumlRelationshipWeight,%
            arm1/.get=\tikzumlRelationshipArmO,%
            arm2/.get=\tikzumlRelationshipArmT,%
            arg1/.get=\tikzumlRelationshipAttrName,%
            arg2/.get=\tikzumlRelationshipAttrNameTO,%
            arg/.get=\tikzumlRelationshipAttrNameTT,%
            mult1/.get=\tikzumlRelationshipMultiplicity,%
            mult2/.get=\tikzumlRelationshipMultiplicityTO,%
            mult/.get=\tikzumlRelationshipMultiplicityTT,%
            pos1/.get=\tikzumlRelationshipPosition,%
            pos2/.get=\tikzumlRelationshipPositionTO,%
            pos/.get=\tikzumlRelationshipPositionTT,%
            align1/.get=\tikzumlRelationshipAlign,%
            align2/.get=\tikzumlRelationshipAlignTO,%
            align/.get=\tikzumlRelationshipAlignTT,%
            anchor1/.get=\tikzumlRelationshipSrcAnchor,%
            anchor2/.get=\tikzumlRelationshipDestAnchor,%
            angle1/.get=\tikzumlRelationshipStartAngle,%
            angle2/.get=\tikzumlRelationshipEndAngle,%
            loopsize/.get=\tikzumlRelationshipLoopSize,%
            stereo/.get=\tikzumlRelationshipStereoType,%
            pos stereo/.get=\tikzumlRelationshipPositionStereo,%
            name/.get=\tikzumlRelationshipName,%
            recursive mode/.get=\tikzumlRelationshipRecursiveMode,%
            recursive direction start/.get=\tikzumlRelationshipRecursiveDirectionStart,%
            recursive direction end/.get=\tikzumlRelationshipRecursiveDirectionEnd%
  }%
  %
  \def\tikzumlSrcClassName{#2}%
  %
  % managing \_ in class names for node names
  \begingroup%
    \def\_{_}\edef\x{\endgroup%
      \def\noexpand\tikzumlSrcClassNodeName{\tikzumlSrcClassName}}\x%
  %
  \StrSubstitute{\tikzumlSrcClassNodeName}{:}{@COLON@}[\tikzumlSrcClassNodeName]%
  \StrSubstitute{\tikzumlSrcClassNodeName}{\_}{@UNDERSCORE@}[\tikzumlSrcClassNodeName]%
  %
  \def\tikzumlDestClassName{#3}%
  \begingroup%
    \def\_{_}\edef\x{\endgroup%
      \def\noexpand\tikzumlDestClassNodeName{\tikzumlDestClassName}}\x%
  %
  \StrSubstitute{\tikzumlDestClassNodeName}{:}{@COLON@}[\tikzumlDestClassNodeName]%
  \StrSubstitute{\tikzumlDestClassNodeName}{\_}{@UNDERSCORE@}[\tikzumlDestClassNodeName]%
  %
  % managing alias keys
  \def\tikzumlRelationshipAttrNameT{\tikzumlRelationshipAttrNameTO\tikzumlRelationshipAttrNameTT}%
  \def\tikzumlRelationshipMultiplicityT{\tikzumlRelationshipMultiplicityTO\tikzumlRelationshipMultiplicityTT}%
  \def\tikzumlRelationshipAlignT{\tikzumlRelationshipAlignTO\tikzumlRelationshipAlignTT}%
  \def\posAttrName{}%
  \def\posMultiplicity{}%
  \def\posAttrNameT{}%
  \def\posMultiplicityT{}%
  %
  \ifthenelse{\equal{\tikzumlRelationshipPositionTT}{tikzumlEmpty}}{%
    \def\tikzumlRelationshipPositionT{\tikzumlRelationshipPositionTO}%
  }{%
    \def\tikzumlRelationshipPositionT{\tikzumlRelationshipPositionTT}%
  }%
  %
  \def\attrAlign{}%
  \def\multAlign{}%
  \def\attrAlignT{}%
  \def\multAlignT{}%
  %
  \ifthenelse{\equal{\tikzumlRelationshipAlign}{left}}{%
    \def\attrAlign{above right}%
    \def\multAlign{below right}%
  }{%
    \ifthenelse{\equal{\tikzumlRelationshipAlign}{right}}{%
      \def\attrAlign{above left}%
      \def\multAlign{below left}%
    }{}%
  }%
  %
  \ifthenelse{\equal{\tikzumlRelationshipAlignT}{left}}{%
    \def\attrAlignT{above right}%
    \def\multAlignT{below right}%
  }{%
    \ifthenelse{\equal{\tikzumlRelationshipAlignT}{right}}{%
      \def\attrAlignT{above left}%
      \def\multAlignT{below left}%
    }{}%
  }%
  %
  % def stereotype
  \ifthenelse{\equal{\tikzumlRelationshipStereoType}{}}{%
    \def\stereotype{}%
  }{%
    \def\stereotype{$\ll$\tikzumlRelationshipStereoType$\gg$}%
  }%
  
  % def anchors macros
  \ifthenelse{\equal{\tikzumlRelationshipSrcAnchor}{tikzumlEmpty}}{%
    \def\tikzumlRelationshipSrcAnchor{}%
  }{%
    \let\tikzumlRelationshipSrcAnchorold\tikzumlRelationshipSrcAnchor%
    \def\tikzumlRelationshipSrcAnchor{.\tikzumlRelationshipSrcAnchorold}%
  }%
  %
  \ifthenelse{\equal{\tikzumlRelationshipDestAnchor}{tikzumlEmpty}}{%
    \def\tikzumlRelationshipDestAnchor{}%
  }{%
    \let\tikzumlRelationshipDestAnchorold\tikzumlRelationshipDestAnchor%
    \def\tikzumlRelationshipDestAnchor{.\tikzumlRelationshipDestAnchorold}%
  }%
  %
  \setcounter{pos}{100*\real{\tikzumlRelationshipPosition}}%
  \setcounter{posT}{100*\real{\tikzumlRelationshipPositionT}}%
  \setcounter{posStereo}{100*\real{\tikzumlRelationshipPositionStereo}}%
  %
  \pgfmathsetmacro{\tikzumlRelationshipWeightT}{1.0-\tikzumlRelationshipWeight}%
  %
  %\newcounter{tikzumlControlNodesNum}%
  %\setcounter{tikzumlControlNodesNum}{0}%
  %
  \coordinate (\tikzumlRelationshipName-middle) at (barycentric cs:\tikzumlSrcClassNodeName=\tikzumlRelationshipWeightT,\tikzumlDestClassNodeName=\tikzumlRelationshipWeight);%
  %
  % straight line
  \ifthenelse{\equal{\tikzumlRelationshipGeometry}{--}}%
  {%
    \ifthenelse{\equal{\tikzumlSrcClassNodeName}{\tikzumlDestClassNodeName}}{%
      \def\arcNum{1}%
      \def\arcNumT{1}%
      %
      \ifthenelse{\equal{\tikzumlRelationshipRecursiveMode}{default}}{%
        \xdef\tikzumlLastArc{node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-attr, pos=\tikzumlRelationshipPosition, \posAttrName, \attrAlign] {\tikzumlRelationshipAttrName}%
                             node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-mult, pos=\tikzumlRelationshipPosition, swap, \posMultiplicity, \multAlign] {\tikzumlRelationshipMultiplicity}%
                             node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-attr2, pos=\tikzumlRelationshipPositionT, \posAttrNameT, \attrAlignT] {\tikzumlRelationshipAttrNameT}%
                             node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-mult2, pos=\tikzumlRelationshipPositionT, swap, \posMultiplicityT, \multAlignT] {\tikzumlRelationshipMultiplicityT}%
                             node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-stereotype, pos=\tikzumlRelationshipPositionStereo, anchor=center] {\stereotype} }%
        \xdef\tikzumlPath{(\tikzumlSrcClassNodeName) edge[in=\tikzumlRelationshipEndAngle, out=\tikzumlRelationshipStartAngle, distance=\tikzumlRelationshipLoopSize] \tikzumlLastArc%
                                                          coordinate[midway] (\tikzumlRelationshipName-1) (\tikzumlDestClassNodeName) }%
      }{%
        \ifthenelse{\equal{\tikzumlRelationshipRecursiveMode}{transition}}{%
          \xdef\tikzumlFirstArc{coordinate[midway] (\tikzumlRelationshipName-1)}%
          \xdef\tikzumlMidOneArc{coordinate[midway] (\tikzumlRelationshipName-3)}%
          %
          \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionStart}{\tikzumlRelationshipRecursiveDirectionEnd}}{%
            \def\numArcs{3}%
            \xdef\tikzumlLastArc{coordinate[midway] (\tikzumlRelationshipName-5)}%
            %
            \begin{pgfonlayer}{connections}%
            \draw (\tikzumlSrcClassNodeName) edge[in=\tikzumlRelationshipEndAngle, out=\tikzumlRelationshipStartAngle, distance=\tikzumlRelationshipLoopSize, draw=none] %
                                                  coordinate[midway] (\tikzumlRelationshipName-tmp) (\tikzumlDestClassNodeName);%
            \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionStart}{right}\OR\equal{\tikzumlRelationshipRecursiveDirectionStart}{left}}{%
              \coordinate (\tikzumlRelationshipName-2) at (\tikzumlSrcClassNodeName.\tikzumlRelationshipStartAngle -| \tikzumlRelationshipName-tmp);%
              \coordinate (\tikzumlRelationshipName-4) at (\tikzumlDestClassNodeName.\tikzumlRelationshipEndAngle -| \tikzumlRelationshipName-tmp);%
            }{%
              \coordinate (\tikzumlRelationshipName-2) at (\tikzumlSrcClassNodeName.\tikzumlRelationshipStartAngle |- \tikzumlRelationshipName-tmp);%
              \coordinate (\tikzumlRelationshipName-4) at (\tikzumlDestClassNodeName.\tikzumlRelationshipEndAngle |- \tikzumlRelationshipName-tmp);%
            }%
            \end{pgfonlayer}%
          }{%
            \def\numArcs{4}%
            \xdef\tikzumlMidTwoArc{coordinate[midway] (\tikzumlRelationshipName-5)}%
            \xdef\tikzumlLastArc{coordinate[midway] (\tikzumlRelationshipName-7)}%
            %
            \begin{pgfonlayer}{connections}%
            \draw (\tikzumlSrcClassNodeName) edge[in=\tikzumlRelationshipEndAngle, out=\tikzumlRelationshipStartAngle, distance=\tikzumlRelationshipLoopSize, draw=none] %
                                                  coordinate[midway] (\tikzumlRelationshipName-4) (\tikzumlDestClassNodeName);%
            \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionStart}{right}\OR\equal{\tikzumlRelationshipRecursiveDirectionStart}{left}}{%
              \coordinate (\tikzumlRelationshipName-2) at (\tikzumlSrcClassNodeName.\tikzumlRelationshipStartAngle -| \tikzumlRelationshipName-4);%
              \coordinate (\tikzumlRelationshipName-6) at (\tikzumlDestClassNodeName.\tikzumlRelationshipEndAngle |- \tikzumlRelationshipName-4);%
            }{%
              \coordinate (\tikzumlRelationshipName-2) at (\tikzumlSrcClassNodeName.\tikzumlRelationshipStartAngle |- \tikzumlRelationshipName-4);%
              \coordinate (\tikzumlRelationshipName-6) at (\tikzumlDestClassNodeName.\tikzumlRelationshipEndAngle -| \tikzumlRelationshipName-4);%
            }%
            \end{pgfonlayer}%
          }%
          %
          \ifnum\numArcs=4%
            \ifnum\theposStereo>300%
              \pgfmathsetmacro{\tikzumlRelationshipPositionStereo}{(\theposStereo-300)/100}%
              \xdef\tikzumlLastArc{\tikzumlLastArc node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-stereotype, pos=\tikzumlRelationshipPositionStereo, anchor=center] {\stereotype}}%
            \else%
              \ifnum\theposStereo<100%
                \xdef\tikzumlFirstArc{\tikzumlFirstArc node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-stereotype, pos=\tikzumlRelationshipPositionStereo, anchor=center] {\stereotype}}%
              \else%
                \ifnum\theposStereo>200%
                  \pgfmathsetmacro{\tikzumlRelationshipPositionStereo}{(\theposStereo-200)/100}%
                  \xdef\tikzumlMidTwoArc{\tikzumlMidTwoArc node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-stereotype, pos=\tikzumlRelationshipPositionStereo, anchor=center] {\stereotype}}%
                \else%
                  \pgfmathsetmacro{\tikzumlRelationshipPositionStereo}{(\theposStereo-100)/100}%
                  \xdef\tikzumlMidOneArc{\tikzumlMidOneArc node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-stereotype, pos=\tikzumlRelationshipPositionStereo, anchor=center] {\stereotype}}%
                \fi%
              \fi%
            \fi%
            %
            \ifthenelse{\thepos=300\OR\thepos=100}{%
              \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionStart}{right}}{%
                \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionEnd}{bottom}}{%
                  \def\posAttrName{above right}%
                  \def\posMultiplicity{below left}%
                }{%
                  \def\posAttrName{above left}%
                  \def\posMultiplicity{below right}%
                }%
              }{%
                \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionStart}{left}}{%
                  \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionEnd}{bottom}}{%
                    \def\posAttrName{above left}%
                    \def\posMultiplicity{below right}%
                  }{%
                    \def\posAttrName{above right}%
                    \def\posMultiplicity{below left}%
                  }%
                }{%
                  \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionStart}{top}}{%
                    \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionEnd}{left}}{%
                      \def\posAttrName{above right}%
                      \def\posMultiplicity{below left}%
                    }{%
                      \def\posAttrName{above left}%
                      \def\posMultiplicity{below right}%
                    }%
                  }{%
                    \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionEnd}{left}}{%
                      \def\posAttrName{above left}%
                      \def\posMultiplicity{below right}%
                    }{%
                      \def\posAttrName{above right}%
                      \def\posMultiplicity{below left}%
                    }%
                  }%
                }%
              }%
            }{}%
            %
            \ifthenelse{\thepos=200}{%
              \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionStart}{right}}{%
                \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionEnd}{bottom}}{%
                  \def\posAttrName{above left}%
                  \def\posMultiplicity{below right}%
                }{%
                  \def\posAttrName{above right}%
                  \def\posMultiplicity{below left}%
                }%
              }{%
                \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionStart}{left}}{%
                  \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionEnd}{bottom}}{%
                    \def\posAttrName{above right}%
                    \def\posMultiplicity{below left}%
                  }{%
                    \def\posAttrName{above left}%
                    \def\posMultiplicity{below right}%
                  }%
                }{%
                  \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionStart}{top}}{%
                    \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionEnd}{left}}{%
                      \def\posAttrName{above left}%
                      \def\posMultiplicity{below right}%
                    }{%
                      \def\posAttrName{above right}%
                      \def\posMultiplicity{below left}%
                    }%
                  }{%
                    \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionEnd}{left}}{%
                      \def\posAttrName{above right}%
                      \def\posMultiplicity{below left}%
                    }{%
                      \def\posAttrName{above left}%
                      \def\posMultiplicity{below right}%
                    }%
                  }%
                }%
              }%
            }{}%
            %
            \ifnum\thepos>300%
              \pgfmathsetmacro{\tikzumlRelationshipPosition}{(\thepos-300)/100}%
              \xdef\tikzumlLastArc{\tikzumlLastArc node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-attr, pos=\tikzumlRelationshipPosition, \posAttrName, \attrAlign] {\tikzumlRelationshipAttrName}%
                                   node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-mult, pos=\tikzumlRelationshipPosition, swap, \posMultiplicity, \multAlign] {\tikzumlRelationshipMultiplicity}%
                                   }%
            \else%
              \ifnum\thepos<100%
                \xdef\tikzumlFirstArc{\tikzumlFirstArc node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-attr, pos=\tikzumlRelationshipPosition, \posAttrName, \attrAlign] {\tikzumlRelationshipAttrName}%
                                     node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-mult, pos=\tikzumlRelationshipPosition, swap, \posMultiplicity, \multAlign] {\tikzumlRelationshipMultiplicity}%
                                     }%
              \else%
                \ifnum\thepos>200%
                  \pgfmathsetmacro{\tikzumlRelationshipPosition}{(\thepos-200)/100}%
                  \xdef\tikzumlMidTwoArc{\tikzumlMidTwoArc node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-attr, pos=\tikzumlRelationshipPosition, \posAttrName, \attrAlign] {\tikzumlRelationshipAttrName}%
                                         node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-mult, pos=\tikzumlRelationshipPosition, swap, \posMultiplicity, \multAlign] {\tikzumlRelationshipMultiplicity}%
                                        }%
                \else%
                  \pgfmathsetmacro{\tikzumlRelationshipPosition}{(\thepos-100)/100}%
                  \xdef\tikzumlMidOneArc{\tikzumlMidOneArc node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-attr, pos=\tikzumlRelationshipPosition, \posAttrName, \attrAlign] {\tikzumlRelationshipAttrName}%
                                         node[text=\tikzumlRelationshipTextColor, /tikzuml/style, name=\tikzumlRelationshipName-mult, pos=\tikzumlRelationshipPosition, swap, \posMultiplicity, \multAlign] {\tikzumlRelationshipMultiplicity}%
                                        }%
