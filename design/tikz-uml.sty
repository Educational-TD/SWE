\newcommand{\umlusecase}[2][]{%
  \stepcounter{tikzumlUseCaseNum}%
  \pgfkeys{/tikzuml/usecase/.cd,%
            x/.initial=\tikzumlDefaultX,%
            y/.initial=\tikzumlDefaultY,%
