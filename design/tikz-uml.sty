                \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionStart}{left}}{%
                  \ifthenelse{\equal{\tikzumlRelationshipRecursiveDirectionEnd}{bottom}}{%
                    \def\posAttrNameT{above left}%
                    \def\posMultiplicityT{below right}%
