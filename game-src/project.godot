; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Geometry Defense"
config/description="Geometry Defense is a tower defense game about defending against various shapes. The purpose is to help middle-schoolers learn the foundational math that they will use in their day-to-day life. The game accomplishes this by having towers only upgradeable by answering age-appropriate math problems, with higher level towers more capable of defeating the enemy shapes. As students understand the material better, they will be able to survive more waves for a better score, encouraging them to learn the material until it becomes instinct."
config/version="0.0.1"
run/main_scene="uid://33k1fu103tyb"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://bailfd4d7wfx2"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
